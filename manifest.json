{
	"name": "Flame Humble New Tab Page",
	"short_name": "FHNTP",
	"version": "1.26.3",
	"minimum_chrome_version": "104",
	"manifest_version": 3,
	"description": "A Flame-inspired new tab with independent YAML bookmarks, local MDI icons, and customizable columns.",
	"icons": {
		"128": "icons/icon_128.png",
		"48": "icons/icon_48.png",
		"16": "icons/icon_16.png"
	},
	"permissions": [
		"favicon",
		"topSites",
		"tabs",
		"fontSettings",
		"sessions"
	],
	"optional_host_permissions": [
		"file:///"
	],
	"chrome_url_overrides": {
		"newtab": "newtab.html"
	},
	"options_ui": {
		"page": "newtab.html?options",
		"open_in_tab": true
	}
}
